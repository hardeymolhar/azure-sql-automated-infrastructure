.terraform/
*.tfvars

# Terraform state, in every form it is written to disk.
#
# The glob is `*.tfstate*`, not the `*.tfstate` + `*.tfstate.backup` pair that used
# to be here. That pair missed the file Terraform writes when it MIGRATES a backend:
# `terraform.tfstate.<unix-timestamp>.backup`, which matches neither pattern. One
# such file (terraform_flat/terraform.tfstate.1785584963.backup) reached a commit and
# GitHub push protection rejected the push — a state file embeds live storage account
# keys and every other sensitive attribute in plaintext.
#
# `*.tfstate*` also covers .tfstate.lock.info and any future suffix Terraform adds.
*.tfstate*

crash.log
.venv
collections
.backups/
.vault_pass
.env
bin/
obj/
*.claude
CLAUDE.md

# Generated Terraform plan artifacts
tfplan
*.tfplan

# Vendored Microsoft DP-300 lab (its own ~200MB git repo)
scripts/shell/dp-300-database-administrator/

# Vendored DP-300 lab archive (~114MB)
docs/lab-files/

# Local Codex/MCP tooling config
.codex/

# Generated Ansible inventory variants (per-VM-type snapshots written by
# vm-config.sh). inventory.ini itself STAYS TRACKED — it is the one the
# playbooks read — but it also carries a plaintext ansible_password, so its
# changes are committed deliberately, never swept in with a broad `git add`.
inventory-*.ini

# vm-config.sh run logs.
.logs/

# Vendored SQL sample database (~59MB binary, not source).
scripts/bacpac/

# macOS Finder metadata.
.DS_Store
